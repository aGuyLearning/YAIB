# Settings for TS2Vec probe (downstream head with optional pretrained encoder).

# Imports to register models/wrappers
import icu_benchmarks.models.wrappers
import icu_benchmarks.models.dl_models.ts2vec

# Must match TS2Vec.gin / pretrain checkpoint input pipeline
base_classification_preprocessor.generate_features = True

# Core train params
train_common.model = @TS2VecProbe
train_common.epochs = 30
train_common.batch_size = 64
train_common.patience = 8
train_common.min_delta = 1e-4
TS2VecProbe.hidden_dim = 256
TS2VecProbe.encoder_layers = 8
TS2VecProbe.dropout = 0.1
TS2VecProbe.num_classes = %NUM_CLASSES
TS2VecProbe.freeze_encoder = True
# Set this to a pretraining checkpoint path when doing transfer:
# TS2VecProbe.pretrained_encoder_path = "/path/to/pretrain/last.ckpt"
