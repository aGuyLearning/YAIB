# Reduced HP search settings for Long Short-Term Memory (LSTM) model.
# Changes vs original:
#   hidden_dim: unchanged at (32, 256) — aki/hirid optimum was 32, keeping lower bound
#   layer_dim:  (1, 3)                 — kept at original; paper uses 3 layers for 5/9 models
#   lr:         added "log" scale      — original lacked it; all observed optima at lower end
#   epochs:     30 → 50               — sepsis LSTM used all 30 epochs without early stopping

include "configs/prediction_models/reduced/common/DLCommon.gin"

# Train params
train_common.model = @LSTMNet
train_common.epochs = 50

# Optimizer params
optimizer/hyperparameter.class_to_tune = @Adam
optimizer/hyperparameter.weight_decay = 1e-6
optimizer/hyperparameter.lr = (1e-5, 3e-4, "log")

# Encoder params
model/hyperparameter.class_to_tune = @LSTMNet
model/hyperparameter.num_classes = %NUM_CLASSES
model/hyperparameter.hidden_dim = (32, 256, "log")
model/hyperparameter.layer_dim = (1, 3)
