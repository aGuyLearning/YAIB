# Reduced HP search settings for ElasticNet (used for LOS and KF regression tasks).
# Changes vs original:
#   alpha:     (1e-2, 1e1) → (1e-2, 1e0, "log")  — removes very high regularisation end;
#              uses "log" scale for correct Optuna log search (was "log-uniform" = linear in Optuna)
#   tol:       (1e-5, 1e-1, "log-uniform") → fixed 1e-4  — convergence criterion, not a HP
#   l1_ratio:  (0.0, 1.0) → (0.1, 0.9)            — avoids degenerate pure-ridge/pure-lasso ends

include "configs/prediction_models/reduced/common/MLCommon.gin"

# Train params
train_common.model = @ElasticNet

model/hyperparameter.class_to_tune = @ElasticNet
model/hyperparameter.n_jobs = 8
model/hyperparameter.max_iter = 10000
model/hyperparameter.alpha = (1e-2, 1e0, "log")
model/hyperparameter.tol = 1e-4
model/hyperparameter.l1_ratio = (0.1, 0.9)
