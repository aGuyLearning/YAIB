# Reduced hyperparameter tuner settings for Deep Learning.
# Budget: 25 trials × 3 folds × 30 epochs.  MedianPruner (2 warmup folds) allows
# pruning only after fold 2, so effective wall-clock cost is ~20 unpruned trials.
tune_hyperparameters.scopes = ["model", "optimizer"]
tune_hyperparameters.n_initial_points = 3
tune_hyperparameters.n_calls = 25
tune_hyperparameters.folds_to_tune_on = 3
