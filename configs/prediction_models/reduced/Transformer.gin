# Reduced HP search settings for Transformer model.
# Changes vs original:
#   ff_hidden_mult: (2,4,6,8) → (2,4)          — paper consistently used 2; keep 4 as upper
#   l1_reg:         (0.0,1.0) → fixed 0.0      — removes non-standard regularisation dimension
#   hidden:         (32,512,"log") → (32,256,"log") — continuous; paper values spread 32-256
#   heads:          (1,8,"log")                 — restored; paper uses 1,2,3,8
#   depth:          (1,3)                       — restored; paper uses depth=3 for some tasks
#   dropout_att:    (0.0,1.0) → (0.0,0.3)      — values >0.5 cripple attention
#   dropout:        kept fixed at 0             — original author found no improvement from tuning
#   lr:             (1e-6,1e-4) → (1e-5,5e-4)  — restores upper end to cover standard Adam lr of 3e-4

include "configs/prediction_models/reduced/common/DLCommon.gin"

# Train params
train_common.model = @Transformer

# Optimizer params
optimizer/hyperparameter.class_to_tune = @Adam
optimizer/hyperparameter.weight_decay = 1e-6
optimizer/hyperparameter.lr = (1e-5, 5e-4, "log")

# Encoder params
model/hyperparameter.class_to_tune = @Transformer
model/hyperparameter.num_classes = %NUM_CLASSES
model/hyperparameter.ff_hidden_mult = (2, 4)
model/hyperparameter.l1_reg = 0.0
model/hyperparameter.hidden = (32, 256, "log")
model/hyperparameter.heads = (1, 8, "log")
model/hyperparameter.depth = (1, 3)
model/hyperparameter.dropout = 0
model/hyperparameter.dropout_att = (0.0, 0.3)
